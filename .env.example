# ===== Ask OLake — secrets & config (never commit) =====

# --- LLM: OpenRouter (organiser key, $3 credit, chat only) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_FALLBACK_MODELS=google/gemini-2.5-flash-lite,z-ai/glm-4.7-flash
LLM_MAX_TOKENS=600
LLM_TEMPERATURE=0.1
LLM_REASONING_EFFORT=none

# --- Embeddings: Cohere on Azure ---
EMBED_PROVIDER=cohere_azure
EMBED_ENDPOINT=https://<your-azure-resource>.services.ai.azure.com/providers/cohere/v2/embed
EMBED_API_KEY=
EMBED_MODEL=Cohere-Embed-V5-Pro
EMBED_DIM=1024                          # confirm supported dim at build time

# --- Reranker: Cohere on Azure (Pro, Fast as fallback) ---
RERANK_PROVIDER=cohere_azure
RERANK_ENDPOINT=https://<your-azure-resource>.services.ai.azure.com/providers/cohere/v2/rerank
RERANK_API_KEY=
RERANK_MODEL=Cohere-rerank-v4.0-pro
RERANK_FALLBACK_ENDPOINT=https://<your-azure-resource>.services.ai.azure.com/providers/cohere/v2/rerank
RERANK_FALLBACK_API_KEY=
RERANK_FALLBACK_MODEL=Cohere-rerank-v4.0-fast

# --- Vector DB: Qdrant ---
# Local docker compose uses http://qdrant:6333 with no key; for cloud (US East) fill both.
QDRANT_URL=http://qdrant:6333           # or https://<cluster>.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=olake_chunks

# --- Sources ---
GITHUB_TOKEN=
GITHUB_ORG=datazip-inc
REPOS=olake,olake-ui,olake-helm,olake-fusion
DOCS_SITEMAP_URL=https://olake.io/sitemap.xml
DOCS_PATH_PREFIX=/docs/
POLL_INTERVAL_SECONDS=60

# --- Retrieval / honesty ---
TOP_K_PREFETCH=30
TOP_K_FUSED=20
TOP_K_FINAL=6
CONTEXT_TOKEN_BUDGET=3000
REFUSAL_THRESHOLD=0.35

# --- Cache ---
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=2000
CACHE_NEW_CHUNK_SIM=0.75

# --- API hardening ---
RATE_LIMIT=120/minute;5000/day
ALLOWED_ORIGINS=*
ADMIN_KEY=
LOG_LEVEL=INFO

# --- MCP server (exposes ask_olake / search_docs tools at /mcp) ---
MCP_ENABLED=true

# --- Cost guard: below this OpenRouter credit, switch to the cheapest model; near zero, serve cache/refuse ---
LLM_BUDGET_SWITCH_USD=1.00
LLM_BUDGET_STOP_USD=0.10
LLM_CHEAP_MODEL=google/gemini-2.5-flash-lite

# --- Deploy (used by you for git push, not by the app) ---
HF_TOKEN=
HF_SPACE=
